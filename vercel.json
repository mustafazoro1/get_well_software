{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm --filter @workspace/api-server run build",
      "outputDirectory": "dist"
    },
    "get-well-cards": {
      "root": "artifacts/get-well-cards",
      "framework": "vite",
      "buildCommand": "pnpm --filter @workspace/get-well-cards run build",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "pnpm --filter @workspace/mockup-sandbox run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "get-well-cards" } }
  ]
}
